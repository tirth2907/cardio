#!/usr/bin/env python3
"""
CardioSense Starter Entry Point
Allows typing:
    python start
    python3 start
    ./start
"""
import sys
import runpy
from pathlib import Path

if __name__ == "__main__":
    target = Path(__file__).resolve().parent / "start.py"
    runpy.run_path(str(target), run_name="__main__")
